# Copy to .env and adjust. `make up` does this automatically if .env is missing.
# DATABASE_URL / TEST_DATABASE_URL are set by docker-compose.yml from the POSTGRES_* values.

POSTGRES_USER=jobindex
POSTGRES_PASSWORD=jobindex
POSTGRES_DB=jobindex
POSTGRES_PORT=5432
APP_PORT=8000

# Crawler etiquette. Put a real contact URL or address in the User-Agent before crawling.
HTTP_USER_AGENT=JobIndexBot/0.1 (+https://example.com/jobindex-bot)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.0
RATE_LIMIT_PER_HOST_SECONDS=1.0
RESPECT_ROBOTS_TXT=true

# Generic sitemap + JSON-LD connectors: fail a crawl (instead of closing jobs) when the
# open-job count falls more than this fraction below the last successful crawl; and
# re-fetch job pages without a sitemap <lastmod> every N days.
GENERIC_MAX_JOB_DROP=0.5
GENERIC_REFRESH_DAYS=7

# Scheduler (`python -m jobindex.cli schedule`, the `worker` service in production).
CRAWL_INTERVAL_MINUTES=60
# Per-platform overrides (JSON); replaces the built-in defaults in jobindex/config.py.
# CRAWL_PLATFORM_INTERVALS={"workday": 240, "oracle": 240, "successfactors": 240, "hireology": 720}
CRAWL_CONCURRENCY=4
CRAWL_JITTER=0.1
CRAWL_STALE_AFTER_HOURS=12

# Deduplication: same company + title + location further apart than this = new opening.
DEDUP_DATE_WINDOW_DAYS=30

# Database connections (jobindex/db.py). Prepared statements are switched off
# automatically for Supabase/PgBouncer pooler URLs; the pool defaults to
# CRAWL_CONCURRENCY + 2 connections.
# DATABASE_POOL_SIZE=
# DATABASE_MAX_OVERFLOW=10
# DATABASE_READ_ONLY=false

# Size budget (docs/OPERATIONS.md#size-budget). Unset = no limits, keep everything.
# MAX_JOBS_PER_SOURCE=200
# DESCRIPTION_HTML_MAX_CHARS=20000
# JOB_CHANGE_VALUE_MAX_CHARS=500
# CLOSED_JOB_RETENTION_DAYS=14
# JOB_CHANGE_RETENTION_DAYS=60
# FETCH_RUN_RETENTION_DAYS=30

LOG_LEVEL=INFO
