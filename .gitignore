# Local configuration (copy from .env.example)
.env
.env.*
!.env.example
!.env.prod.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches / reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log

# Note: coverage/results.json IS committed on purpose — it keeps each example board's
# "last successful run" across machines (see jobindex/coverage.py).

# Production database dumps (docker-compose.prod.yml backup service)
backups/

# Research sessions: raw third-party page dumps and throwaway scripts stay local.
# Only the request-level evidence cited by coverage/blocked_by_site.yaml is committed.
.research/*
!.research/access*.jsonl
!.research/robots3.txt

# Local data: database dumps, SQLite files, Vercel/Supabase CLI state
*.dump
*.pgdump
*.sql.gz
*.sqlite
*.sqlite3
/data/
.vercel/
supabase/.temp/
