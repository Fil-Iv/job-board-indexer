# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it):
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Every setting of .env.example (jobindex/config.py) can be set here too.

# Public hostname (DNS A/AAAA record pointing at the VPS) and the address Let's Encrypt
# uses for expiry notices.
DOMAIN=jobs.example.com
ACME_EMAIL=ops@example.com

# Database. Generate a password with: openssl rand -hex 24
POSTGRES_USER=jobindex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobindex

# Identify the crawler honestly: a URL describing the bot and how to contact you.
HTTP_USER_AGENT=JobIndexBot/0.1 (+https://jobs.example.com/bot)
RATE_LIMIT_PER_HOST_SECONDS=1.0
RESPECT_ROBOTS_TXT=true

# Crawl schedule (see docs/OPERATIONS.md).
CRAWL_INTERVAL_MINUTES=60
# CRAWL_PLATFORM_INTERVALS={"workday": 240, "oracle": 240, "successfactors": 240, "hireology": 720}
CRAWL_CONCURRENCY=4

# API processes (uvicorn workers).
APP_WORKERS=2

# Backups: daily at BACKUP_HOUR (UTC) into BACKUP_DIR, kept BACKUP_KEEP_DAYS days.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

LOG_LEVEL=INFO
